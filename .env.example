# ByteReel pipeline configuration (PIPELINE_DESIGN.md §10).
# TEMPLATE ONLY — this file is committed to git. Never put real keys here.
# Copy to `.env` (ignored by git) and fill in real values there.
# P0/P1 fixture work needs NONE of these. `npm run pipeline -- preflight` shows what is missing.

# --- Needed for live English generation (P2) ---
GEMINI_API_KEY=
# The storyboard planner model (PRD decision #19: gemini-3.6-flash; the web app requires it, F15).
# Design baseline in preflight is gemini-3.8-flash; preflight reports the substitution.
# The web app's "Brainstorm with AI" (F14) uses GEMINI_API_KEY too: set it in Vercel.
GEMINI_MODEL=gemini-3.6-flash
# Optional: the model for "Brainstorm with AI" only (PRD decision #26). Empty = gemini-3.1-flash-lite.
# The storyboard planner keeps GEMINI_MODEL. Use a fixed model id, never a "-latest" alias (refused),
# and a model that accepts Gemini's thinkingLevel setting (brainstorm sends thinkingLevel "low").
GEMINI_BRAINSTORM_MODEL=
# The web app's video job (F23) reads these too: the key, the model and BOTH English voices
# (Female = ELEVENLABS_VOICE_ID_INDIAN_FEMALE, Male = ELEVENLABS_VOICE_ID_INDIAN_MALE; on the free plan
# the premade voices Matilda and Brian). There is no fallback voice: a missing one stops the job.
# Voice characters: 3,000 per creator per month and 9,000 for the whole app per month
# (APP_VOICE_CHARACTERS_PER_MONTH in packages/db/src/usage.ts; the free account has 10,000).
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_multilingual_v2
ELEVENLABS_VOICE_ID_INDIAN_MALE=
ELEVENLABS_VOICE_ID_INDIAN_FEMALE=

# --- [ByteReel] Needed from the Hindi/Hinglish stage onward (P3) ---
# Hinglish narration uses these same Hindi voices (no separate Hinglish voices).
ELEVENLABS_VOICE_ID_HINDI_MALE=
ELEVENLABS_VOICE_ID_HINDI_FEMALE=

# MongoDB Atlas (F05/F06): connection string from Atlas > Connect > Drivers. Real value only in .env
MONGODB_URI=
MONGODB_DB=bytereel

# Cloudflare R2 file storage (F22): videos, narration audio, thumbnails. Real values only in .env
# The bucket is PRIVATE (no public access, no r2.dev address). Files are only read through short-lived links.
# Make the token in Cloudflare → R2 → Manage API tokens: permission "Object Read & Write",
# applied to THIS bucket only (never an admin token or "all buckets").
# R2_ACCOUNT_ID: the 32-character Account ID (R2 overview page), not the full https:// address.
# Check everything with: npm run storage -- check
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# reel-app-dev on your computer, reel-app-prod in production (F38). Bucket names are fixed: don't rename.
R2_BUCKET=reel-app-dev

# Login (F08, Better Auth). Real values only in .env
# BETTER_AUTH_SECRET signs the login cookie: a long random text, at least 32 characters.
#   Make one with: openssl rand -base64 32   (a different one for production, set in Vercel)
# BETTER_AUTH_URL is the app's address with no path: http://localhost:3000 on your computer,
#   the real https:// domain in production. Sign-up/login requests from any other address are refused.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Background jobs (F15, Inngest). NOTHING to set on your computer: `npm run dev` sets INNGEST_DEV=1, so
# the app talks to the local Inngest Dev Server (`npm run inngest`, http://localhost:8288) in dev mode.
# Any other way of starting the app (next start, a server) needs both keys below, or it refuses to run jobs.
# Production / preview on Vercel ONLY (set up in F38, Inngest dashboard): both keys are required there,
# and INNGEST_DEV must never be set on Vercel (dev mode turns off the signature check; the app refuses it).
# INNGEST_EVENT_KEY=
# INNGEST_SIGNING_KEY=
# Optional, local only: another Inngest Dev Server address (the automated test uses http://localhost:8299).
# INNGEST_DEV=

# Automated tests ONLY (F14): E2E_FAKE_GEMINI=1 replaces Gemini with a local stand-in for the
# end-to-end check. It works only with MONGODB_DB=bytereel_test on http://localhost:3230-3239 and
# never on Vercel; set anywhere else, "Brainstorm with AI" refuses to run. Never put it in .env or Vercel.
# E2E_FAKE_GEMINI=
# Automated tests ONLY (F23): E2E_FAKE_ELEVENLABS=1 replaces ElevenLabs with a local stand-in voice
# (silent audio + timings, ZERO ElevenLabs calls) for the video e2e check. Same rule: only with
# MONGODB_DB=bytereel_test on http://localhost:3230-3239, never on Vercel. And on bytereel_test the
# REAL voice is always refused, so a test can never spend real characters. Never put it in .env or Vercel.
# E2E_FAKE_ELEVENLABS=
