# ByteReel pipeline configuration (PIPELINE_DESIGN.md §10).
# TEMPLATE ONLY — this file is committed to git. Never put real keys here.
# Copy to `.env` (ignored by git) and fill in real values there.
# P0/P1 fixture work needs NONE of these. `npm run pipeline -- preflight` shows what is missing.

# --- Needed for live English generation (P2) ---
GEMINI_API_KEY=
# Design baseline model; preflight reports it, and any substitution must be recorded.
# The web app's "Brainstorm with AI" (F14) uses GEMINI_API_KEY too: set it in Vercel.
GEMINI_MODEL=gemini-3.8-flash
# Optional: the model for "Brainstorm with AI" only (PRD decision #26). Empty = gemini-3.1-flash-lite.
# The storyboard planner keeps GEMINI_MODEL. Use a fixed model id, never a "-latest" alias (refused),
# and a model that accepts Gemini's thinkingLevel setting (brainstorm sends thinkingLevel "low").
GEMINI_BRAINSTORM_MODEL=
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_multilingual_v2
ELEVENLABS_VOICE_ID_INDIAN_MALE=
ELEVENLABS_VOICE_ID_INDIAN_FEMALE=

# --- [ByteReel] Needed from the Hindi/Hinglish stage onward (P3) ---
# Hinglish narration uses these same Hindi voices (no separate Hinglish voices).
ELEVENLABS_VOICE_ID_HINDI_MALE=
ELEVENLABS_VOICE_ID_HINDI_FEMALE=

# MongoDB Atlas (F05/F06): connection string from Atlas > Connect > Drivers. Real value only in .env
MONGODB_URI=
MONGODB_DB=bytereel

# Login (F08, Better Auth). Real values only in .env
# BETTER_AUTH_SECRET signs the login cookie: a long random text, at least 32 characters.
#   Make one with: openssl rand -base64 32   (a different one for production, set in Vercel)
# BETTER_AUTH_URL is the app's address with no path: http://localhost:3000 on your computer,
#   the real https:// domain in production. Sign-up/login requests from any other address are refused.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Automated tests ONLY (F14): E2E_FAKE_GEMINI=1 replaces Gemini with a local stand-in for the
# end-to-end check. It works only with MONGODB_DB=bytereel_test on http://localhost:3230-3239 and
# never on Vercel; set anywhere else, "Brainstorm with AI" refuses to run. Never put it in .env or Vercel.
# E2E_FAKE_GEMINI=
