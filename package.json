{
  "name": "bytereel",
  "version": "0.0.0",
  "private": true,
  "description": "ByteReel explainer-reel pipeline prototype (P0 foundation, P1 visual skeleton, P2a live Gemini planning + approval gate, P2b ElevenLabs speech + generate/resume).",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "npm run dev -w @bytereel/web",
    "inngest": "npx --yes inngest-cli@1.49.0 dev --no-discovery -u http://localhost:3000/api/inngest",
    "pipeline": "tsx tools/cli/index.ts",
    "db": "tsx tools/cli/db.ts",
    "voices:samples": "tsx tools/cli/index.ts voice-samples",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && npm run typecheck --workspace @bytereel/web",
    "studio": "remotion studio packages/video/src/index.ts"
  },
  "dependencies": {
    "@fontsource/inter": "5.2.8",
    "@fontsource/noto-sans-devanagari": "5.2.8",
    "@google/genai": "2.32.0",
    "@remotion/bundler": "4.0.540",
    "@remotion/cli": "4.0.540",
    "@remotion/fonts": "4.0.540",
    "@remotion/renderer": "4.0.540",
    "mongodb": "7.7.0",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "remotion": "4.0.540",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
