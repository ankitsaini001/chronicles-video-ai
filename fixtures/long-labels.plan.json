      "id": "scene-plant",
      "type": "labeled-diagram",
      "narration": [
        {
          "id": "line-plant",
          "text": "Inside a recycling plant, trucks unload on a tipping floor. Optical scanners sort the plastic by colour, and magnets pull out tins. Shredders cut bottles into chips, hot water tanks wash them, and extruders melt the flakes into pellets.",
          "hero": "factory"
        }
      ],
