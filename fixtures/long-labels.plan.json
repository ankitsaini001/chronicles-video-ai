  "topic": "How plastic recycling works",
  "audience": "Families in Indian cities who sort their household waste",
  "learningObjective": "Follow a plastic bottle from the bin through a recycling plant and back into a new product",
  "language": "en",
  "voicePreset": "indian-english-female",
  "sources": [
    {
      "id": "topic-notes",
      "title": "Fixture notes",
      "notes": "Layout fixture (F22b review): the longest labels a plan allows (60 characters for comparison points and takeaway rows, 32 for diagram parts), a 7-step process rail and a 7-bar chart. Illustrative numbers only."
    }
  ],
  "scenes": [
    {
      "id": "scene-hook",
      "type": "title-hook",
      "narration": [
        {
          "id": "line-hook",
          "text": "Have you ever wondered where your plastic bottle goes after the bin? It starts a long journey.",
          "hero": "question-mark"
        }
      ],
      "objects": [
        {
          "id": "hook-title",
          "kind": "headline",
          "label": "Where does your plastic go?",
          "value": null
        },
        {
          "id": "hook-sub",
          "kind": "subtitle",
          "label": "From your bin to a new bottle in a few weeks",
          "value": null
        }
      ],
      "events": [
        {
          "id": "ev-hook-title",
          "anchor": {
            "narrationId": "line-hook",
            "phrase": "where your plastic bottle goes"
          },
          "action": "appear",
          "target": "hook-title"
        },
        {
          "id": "ev-hook-sub",
          "anchor": {
            "narrationId": "line-hook",
            "phrase": "a long journey"
          },
          "action": "appear",
          "target": "hook-sub"
        }
      ]
    },
    {
      "id": "scene-compare",
      "type": "comparison",
      "narration": [
        {
          "id": "line-compare-recycled",
          "text": "Recycled plastic uses far less energy than new plastic made from crude oil. It keeps bottles out of our rivers and seas, and it comes back as clothes, benches and pipes.",
          "hero": "globe"
        },
        {
          "id": "line-compare-new",
          "text": "New plastic needs oil or gas pumped out of the ground. Every new bottle may end up as waste, but it often costs less, because collecting used plastic is costly.",
          "hero": "factory"
        }
      ],
      "objects": [
        {
          "id": "col-recycled",
          "kind": "column",
          "label": "Recycled plastic",
          "value": null
        },
        {
          "id": "pt-energy",
          "kind": "point",
          "label": "Uses far less energy than making new plastic from crude oil.",
          "value": null
        },
        {
          "id": "pt-rivers",
          "kind": "point",
          "label": "Keeps old bottles and bags out of our rivers, seas and parks",
          "value": null
        },
        {
          "id": "pt-clothes",
          "kind": "point",
          "label": "Comes back as new clothes, benches, pipes and drink bottles.",
          "value": null
        },
        {
          "id": "col-new",
          "kind": "column",
          "label": "New plastic",
          "value": null
        },
        {
          "id": "pt-oil",
          "kind": "point",
          "label": "Needs oil or gas pumped out of the ground before it is made.",
          "value": null
        },
        {
          "id": "pt-waste",
          "kind": "point",
          "label": "Every new bottle adds plastic that may end up as waste later",
          "value": null
        },
        {
          "id": "pt-cost",
          "kind": "point",
          "label": "Often costs less today, as collecting used plastic is costly",
          "value": null
        }
      ],
      "events": [
        {
