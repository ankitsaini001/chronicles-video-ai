          "value": 1
        }
      ],
      "events": [
        {
          "id": "ev-axis",
          "anchor": {
            "narrationId": "line-chart-oceans",
            "phrase": "Most of Earth's water"
          },
          "action": "appear",
          "target": "axis"
        },
        {
          "id": "ev-oceans",
          "anchor": {
            "narrationId": "line-chart-oceans",
            "phrase": "97 percent"
          },
          "action": "grow",
          "target": "bar-oceans"
        },
        {
          "id": "ev-ice",
          "anchor": {
            "narrationId": "line-chart-rest",
            "phrase": "frozen in ice"
          },
          "action": "grow",
          "target": "bar-ice"
        },
        {
          "id": "ev-fresh",
          "anchor": {
            "narrationId": "line-chart-rest",
            "phrase": "only around 1 percent"
          },
          "action": "grow",
          "target": "bar-fresh"
        },
        {
          "id": "ev-fresh-highlight",
          "anchor": {
            "narrationId": "line-chart-rest",
