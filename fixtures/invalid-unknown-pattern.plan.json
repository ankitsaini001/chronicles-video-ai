    },
    {
      "id": "scene-takeaway",
      "type": "takeaway",
      "narration": [
        {
          "id": "line-take-loop",
          "text": "So remember the loop: evaporation, condensation, precipitation and collection."
        },
        {
          "id": "line-take-glass",
          "text": "The same water keeps moving around our planet, again and again. The glass of water you drink today may once have been a cloud."
        }
      ],
      "objects": [
